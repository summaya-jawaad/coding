#include <iostream>
using namespace std;

int main() {
    int age, hasCard;
    cout << "Enter your age: ";
    cin >> age;

    if (age >= 18) {
        cout << "Enter 1 if you have an ID card, 0 if not: ";
        cin >> hasCard;
        if (hasCard == 1) {
            cout << "You can vote" << endl;
        } else {
            cout << "You need an ID card to vote" << endl;
        }
    } else {
        cout << "You are too young to vote" << endl;
    }
    return 0;
}
