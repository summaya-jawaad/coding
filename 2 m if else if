#include <iostream>
using namespace std;

int main() {
    int units, bill;
    cout << "Enter water units used: ";
    cin >> units;

    if (units < 0) {
        cout << "Invalid units" << endl;
    } else {
        if (units <= 100) {
            bill = units * 5;
        } else if (units <= 300) {
            bill = 500 + (units - 100) * 8;
        } else if (units <= 500) {
            bill = 2100 + (units - 300) * 12;
        } else {
            bill = 4500 + (units - 500) * 15;
        }
        cout << "Water bill: " << bill << endl;
    }
    return 0;
}
