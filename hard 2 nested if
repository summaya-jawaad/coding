#include <iostream>
using namespace std;

int main() {
    float weight, height, bmi;
    int age;
    cout << "Enter weight in kg: ";
    cin >> weight;
    cout << "Enter height in meters: ";
    cin >> height;
    cout << "Enter age: ";
    cin >> age;

    if (weight > 0 && height > 0) {
        if (age >= 18) {
            bmi = weight / (height * height);
            cout << "Your BMI is: " << bmi << endl;

            if (bmi < 18.5) {
                if (bmi < 16) {
                    cout << "Severely underweight, please see a doctor" << endl;
                } else {
                    cout << "Underweight" << endl;
                }
            } else {
                if (bmi < 25) {
                    cout << "Normal weight" << endl;
                } else {
                    if (bmi < 30) {
                        cout << "Overweight" << endl;
                    } else {
                        if (bmi >= 40) {
                            cout << "Obese Class 3, please see a doctor" << endl;
                        } else {
                            if (bmi >= 35) {
                                cout << "Obese Class 2" << endl;
                            } else {
                                cout << "Obese Class 1" << endl;
                            }
                        }
                    }
                }
            }
        } else {
            cout << "This BMI chart is for adults (18 and above) only" << endl;
        }
    } else {
        cout << "Invalid weight or height" << endl;
    }
    return 0;
}
