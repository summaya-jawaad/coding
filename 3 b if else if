#include <iostream>
using namespace std;

int main() {
    int temp;
    cout << "Enter temperature in Celsius: ";
    cin >> temp;

    if (temp < 10) {
        cout << "It is very cold" << endl;
    } else if (temp < 20) {
        cout << "It is cool" << endl;
    } else if (temp < 30) {
        cout << "It is pleasant" << endl;
    } else if (temp < 40) {
        cout << "It is hot" << endl;
    } else {
        cout << "It is extremely hot" << endl;
    }
    return 0;
}
