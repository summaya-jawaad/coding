// if else ladder
#include<iostream>
using namespace std;
int main()
{
    int age;
    string gender;
    cout<<"enter gender (male or female)= ";
    cin>>gender;
    cout<<"enter age= ";
    cin>>age;
    if(gender=="male"&&age>=16)
    {
        cout<<"Youre eligible for a scooter!"<<endl;
    }
    else if(gender=="Female"&&age>=18)
    {
        cout<<"Youre eligible for a scooter!"<<endl;
    }
    else if(gender=="Male"||gender=="Female")
    {
        cout<<"You are not eligible for a scooter."<<endl;
    }
    else
    {
        cout<<"Invalid gender."<<endl;
    }
    return 0;
}
