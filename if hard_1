//program check that a number is a three-digit multiple of 5
#include<iostream>
using namespace std;
int main()
{
    int num;
    cout<<"Enter a number: ";
    cin>>num;
    if(num>=100&&num<=999&&num%5==0)
    {
        cout<<"The number is a three-digit multiple of 5."<<endl;
    }
    return 0;
}
