#include <iostream>
using namespace std;

int main() {
    float m1, m2, m3, percentage;
    cout << "Enter marks of 3 subjects (out of 100): ";
    cin >> m1 >> m2 >> m3;

    if (m1 >= 40 && m2 >= 40 && m3 >= 40) {
        percentage = (m1 + m2 + m3) / 3;
        cout << "Result: Pass" << endl;
        cout << "Percentage: " << percentage << endl;
        if (percentage >= 80) {
            cout << "Grade A" << endl;
        } else {
            if (percentage >= 60) {
                cout << "Grade B" << endl;
            } else {
                cout << "Grade C" << endl;
            }
        }
    } else {
        cout << "Result: Fail" << endl;
    }
    return 0;
}
