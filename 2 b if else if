#include <iostream>
using namespace std;

int main() {
    int light;
    cout << "Enter light (1 = Red, 2 = Yellow, 3 = Green): ";
    cin >> light;

    if (light == 1) {
        cout << "Stop" << endl;
    } else if (light == 2) {
        cout << "Get ready" << endl;
    } else if (light == 3) {
        cout << "Go" << endl;
    } else {
        cout << "Invalid light" << endl;
    }
    return 0;
}
