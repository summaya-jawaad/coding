// triangle name by its angles 
#include<iostream>
using namespace std;
int main()
{
    int a,b,c;
    cout<<"enter first side: ";
    cin>>a;
    cout<<"enter second side: ";
    cin>>b;
    cout<<"enter third side: ";
    cin>>c;
    if(a<=0||b<=0||c<=0)
    {
        cout<<"invalid side lengths. Not a triangle"<<endl;
    }
    else if(a+b<=c||a+c<=b||b+c<=a)
    {
        cout<<"triangle cannot be possible"<<endl;
    }
    else if(a==b&&b==c)
    {
        cout<<"Equilateral triangle"<<endl;// a b c equal
    }
    else if(a==b||a==c||b==c)// two sides equal 
    {
        cout<<"Isosceles triangle."<<endl;
    }
    else
    {
        cout<<"scalene triangle."<<endl;
    }
    return 0;
}
