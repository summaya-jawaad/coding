// vending machine
#include<iostream>
using namespace std;
int main()
{
    int choice,quantity,price;
    int total;
    cout<<"----vending machine----"<<endl;
    cout<<"1. chips - rs.100"<<endl;
    cout<<"2. chocolate - rs.150"<<endl;
    cout<<"3. juice - rs.200"<<endl;
    cout<<"4. biscuits - rs.80"<<endl;
    cout<<"5. water bottle - rs.50"<<endl;

    cout<<"select an item: ";
    cin>>choice;

    switch(choice)
    {
        case 1:
            price=100;
            break;
        case 2:
            price=150;
            break;
        case 3:
            price=200;
            break;
        case 4:
            price=80;
            break;
        case 5:
            price=50;
            break;
        default:
            price=0;
    }

    if(price==0)
    {
        cout<<"invalid item selection"<<endl;
    }
    else
    {
        cout<<"enter quantity (1-4): ";
             cin>>quantity;
        if(quantity<1||quantity>4)
        {
            cout<<"invalid quantity. you can only buy 1 to 4 of the same item."<<endl;
        }
        else
        {
            total=price*quantity;
            cout<<"price per item: rs."<<price<<endl;
            cout<<"quantity: "<<quantity<<endl;
            cout<<"total bill: rs."<<total<<endl;
            cout<<"thank you for shopping!"<<endl;
        }
    }
    return 0;
}
