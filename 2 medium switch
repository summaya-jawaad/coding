#include <iostream>
using namespace std;

int main() {
    int choice;
    double value, result;

    cout << "1. Kilometers to miles" << endl;
    cout << "2. Kilograms to pounds" << endl;
    cout << "3. Celsius to Fahrenheit" << endl;
    cout << "4. Meters to feet" << endl;
    cout << "Enter your choice: ";
    cin >> choice;
    cout << "Enter the value: ";
    cin >> value;

    switch (choice) {
        case 1:
            result = value * 0.621371;
            cout << value << " km = " << result << " miles" << endl;
            break;
        case 2:
            result = value * 2.20462;
            cout << value << " kg = " << result << " pounds" << endl;
            break;
        case 3:
            result = value * 9 / 5 + 32;
            cout << value << " C = " << result << " F" << endl;
            break;
        case 4:
            result = value * 3.28084;
            cout << value << " m = " << result << " feet" << endl;
            break;
        default:
            cout << "Invalid choice" << endl;
    }
    return 0;
}
