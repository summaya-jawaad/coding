#include <iostream>
using namespace std;

int main() {
    int bill, isMember;
    cout << "Enter total bill: ";
    cin >> bill;
    cout << "Enter 1 if you are a member, 0 if not: ";
    cin >> isMember;

    if (bill >= 5000) {
        if (isMember == 1) {
            cout << "You get 20% discount" << endl;
        } else {
            cout << "You get 10% discount" << endl;
        }
    } else {
        cout << "No discount" << endl;
    }
    return 0;
}
