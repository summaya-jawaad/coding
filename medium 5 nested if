#include <iostream>
using namespace std;

int main() {
    int daysLate, isStudent, fine;
    cout << "Enter number of days the book is late: ";
    cin >> daysLate;
    cout << "Enter 1 if you are a student, 0 if not: ";
    cin >> isStudent;

    if (daysLate >= 0) {
        if (daysLate == 0) {
            cout << "No fine, book returned on time" << endl;
        } else {
            if (daysLate <= 7) {
                fine = daysLate * 10;
            } else {
                fine = 70 + (daysLate - 7) * 20;
            }

            if (isStudent == 1) {
                if (fine > 100) {
                    fine = fine - 50;
                    cout << "Student concession of 50 applied" << endl;
                }
            }
            cout << "Total fine: " << fine << endl;
        }
    } else {
        cout << "Invalid number of days" << endl;
    }
    return 0;
}
