// password strength 
#include<iostream>
#include<string>
using namespace std;
int main()
{
    string password;
    cout<<"Enter a password: ";
    cin>>password;
    if(password.length()<8) // length() is used in string and its for letters as well. Important.
    //password is the variable
    {
        cout<<"Too short. Weak password."<<endl;
    }
    else
    {
        cout<<"Password length is acceptable!"<<endl;
    }
    return 0;
}
